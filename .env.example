# Copy to .env; keep credentials and machine-specific paths out of Git.
# Values are literal. Quotes are optional; no variable expansion or inline comments.
PLAN_MODEL=
PLAN_API_URL=
PLAN_API_KEY=
# OpenAI-compatible base URL, normally ending in /v1.
# For an unauthenticated private endpoint, explicitly set PLAN_API_KEY=EMPTY.
PLAN_THINKING_STYLE=none
OSWORLD_BROWSER_CHANNEL=auto
# Optional local tokenizer/processor folders. Relative paths start at this repo.
PLAN_TOKENIZER_PATH=
PLAN_PROCESSOR_PATH=

# Optional node/visual grounding, independent from the planning model.
GROUNDING_API_URL=
GROUNDING_MODEL=grounding
GROUNDING_API_KEY=
# auto / structured (nodes + visual) / pixel / normalized
# For arbitrary deployment IDs, set the actual protocol explicitly.
GROUNDING_PROTOCOL=auto
GROUNDING_THINKING_STYLE=vllm
GROUNDING_TOKENIZER_PATH=
GROUNDING_PROCESSOR_PATH=

# Optional full desktop / VMware mode. Relative paths start at this repository.
OSWORLD_DESKTOP_ENV_PATH=external/OSWorld
OSWORLD_EXAMPLES_DIR=external/OSWorld/evaluation_examples/examples
OSWORLD_VM_PATH=
OSWORLD_SNAPSHOT_NAME=init_state
# Leave blank to use the external checkout's requirements.txt.
OSWORLD_DESKTOP_REQUIREMENTS=
# Leave blank unless the OSWorld task setup requires an upstream proxy.
OSWORLD_UPSTREAM_PROXY=
OSWORLD_MODEL_PRESETS=config/model_presets.local.yaml
AGENTS_RESULTS_DIR=artifacts/viz
AGENTS_VIZ_PORT=8088
